# Firebase Client Configuration (public browser keys)
# Get these values from: https://console.firebase.google.com -> Project Settings -> General -> Your apps
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ------------------------------------------------------------------
# Server-Only Environment Variables (Set in Vercel Project Settings)
# NEVER prefix these with VITE_
# ------------------------------------------------------------------

# Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token

# Bot username WITHOUT @ (e.g., my_sked_bot)
TELEGRAM_BOT_USERNAME=your_sked_bot

# Random secret string used when registering the Telegram webhook (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-secret

# Secret used by Vercel Cron / GitHub Actions to authorize /api/cron/reminders
CRON_SECRET=generate-another-long-random-secret

# Firebase Service Account JSON (raw JSON string OR base64-encoded JSON)
# From: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Public base URL of your deployed app for clickable workspace links in Telegram messages
APP_BASE_URL=https://your-app.vercel.app

# Google Cloud Tasks (for exact-time, zero-polling Personal Agenda Telegram reminders)
# Create queue in GCP Console -> Cloud Tasks, and grant your Firebase service account
# the "Cloud Tasks Enqueuer" (and optional "Cloud Tasks Task Deleter") IAM role.
CLOUD_TASKS_LOCATION=asia-southeast1
CLOUD_TASKS_QUEUE=sked-reminders
