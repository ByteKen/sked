rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Private user workspaces, tasks, and preferences (strictly owner-only)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    function isChartOwner() {
      return request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    function isChartEditor() {
      return request.auth != null
             && request.auth.token.email != null
             && resource.data.editorEmails is list
             && request.auth.token.email.lower() in resource.data.editorEmails;
    }

    // Invited editors may only mutate live schedule content, never ownership, title, prefs, or editor list
    function onlyCollaborativeContentChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['tasks', 'nextId', 'baseline', 'version', 'lastEditedBy', 'updatedAt'])
             && request.resource.data.ownerId == resource.data.ownerId
             && request.resource.data.shareId == resource.data.shareId;
    }

    // Shared Gantt charts:
    // - Anyone with the exact shareId link can read (get)
    // - Signed-in invited editors can list ONLY charts explicitly shared with their email ("Shared with me")
    // - Owner has full write/delete; invited editors can update tasks/baseline collaboratively
    match /sharedCharts/{shareId} {
      allow get: if true;
      allow list: if request.auth != null
                  && request.auth.token.email != null
                  && resource.data.editorEmails is list
                  && request.auth.token.email.lower() in resource.data.editorEmails;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if isChartOwner()
                    || (isChartEditor() && onlyCollaborativeContentChanged());
      allow delete: if isChartOwner();
    }

    // Server-managed Telegram reminder subscriptions & short-lived link tokens (Firebase Admin SDK only)
    match /telegramSubscriptions/{userId} {
      allow read, write: if false;
    }
    match /telegramLinkTokens/{tokenId} {
      allow read, write: if false;
    }
  }
}
