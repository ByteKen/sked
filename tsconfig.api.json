{
  "extends": "./api/tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "api/**/*.ts",
    "src/domain/agenda.ts",
    "src/domain/reminders.ts",
    "src/domain/systemStatus.ts",
    "src/domain/telegramBot.ts",
    "src/types/agenda.ts",
    "src/types/task.ts"
  ]
}